{
  "manifest_version": 3,
  "name": "Treco",
  "version": "__VERSION__",
  "description": "The Complete YouTube Toolkit. All the tricks you need for a better YouTube.",
  "author": "rafelolv",
  "homepage_url": "https://github.com/rafelolv/Zynubo",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Treco",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://youtubekids.com/*",
    "https://www.youtubekids.com/*"
  ],
  "optional_host_permissions": [
    "https://sponsor.ajay.app/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://youtubekids.com/*",
        "https://www.youtubekids.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN",
      "exclude_matches": [
        "https://*.youtube.com/live_chat*"
      ]
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://youtubekids.com/*",
        "https://www.youtubekids.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "https://*.youtube.com/live_chat*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ytab-network-blocks",
        "enabled": true,
        "path": "rules/network-blocks.json"
      }
    ]
  }
}
